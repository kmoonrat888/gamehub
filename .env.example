# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API Keys
# บน Vercel ให้ตั้งค่า 2 ตัวนี้ที่ Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
# ใช้คีย์ที่ขึ้นต้นด้วย sb_publishable_ เท่านั้น ห้ามใส่ secret key หรือ service_role
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
